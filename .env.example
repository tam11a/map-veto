# Copy to .env.local for local development, and add the same variables in
# Netlify > Site configuration > Environment variables for production.

# HenrikDev API key (https://api.henrikdev.xyz/dashboard/) — used server-side only:
# by netlify/functions/rotation.mjs, the build-time snapshot and the Vite dev route.
HENRIK_API_KEY=

# Region queried for the queue status (eu, na, ap, kr). The ranked rotation is global.
HENRIK_REGION=eu
